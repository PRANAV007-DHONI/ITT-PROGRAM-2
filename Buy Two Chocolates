int buyChoco(int* prices, int pricesSize, int money) {
    int min1 = 101; 
    int min2 = 101;

    for (int i = 0; i < pricesSize; i++) {
        if (prices[i] < min1) {
            min2 = min1;
            min1 = prices[i];
        } else if (prices[i] < min2) {
            min2 = prices[i];
        }
    }

    int total_cost = min1 + min2;

    if (total_cost <= money) {
        return money - total_cost;
    } else {
        return money;
    }
}
