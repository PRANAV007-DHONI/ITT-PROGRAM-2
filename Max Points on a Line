#include <stdlib.h>
#include <math.h>

typedef struct {
    int dx;
    int dy;
} Slope;


int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

int compareSlopes(const void* a, const void* b) {
    Slope* s1 = (Slope*)a;
    Slope* s2 = (Slope*)b;

    long long diff = (long long)s1->dx * s2->dy - (long long)s1->dy * s2->dx;
    if (diff < 0) return -1;
    if (diff > 0) return 1;
    return 0;
}

int maxPoints(int** points, int pointsSize, int* pointsColSize) {
    if (pointsSize <= 2) {
        return pointsSize;
    }

    int globalMax = 2;

    Slope* slopes = (Slope*)malloc(pointsSize * sizeof(Slope));

    for (int i = 0; i < pointsSize; i++) {
        int slopeCount = 0;

        for (int j = 0; j < pointsSize; j++) {
            if (i == j) continue;

            int dx = points[j][0] - points[i][0];
            int dy = points[j][1] - points[i][1];

            int g = gcd(dx, dy);
            dx /= g;
            dy /= g;
            if (dx < 0 || (dx == 0 && dy < 0)) {
                dx = -dx;
                dy = -dy;
            }

            slopes[slopeCount].dx = dx;
            slopes[slopeCount].dy = dy;
            slopeCount++;
        }

        qsort(slopes, slopeCount, sizeof(Slope), compareSlopes);

        int currentMax = 1; 
        int localStreak = 1;
        for (int k = 1; k < slopeCount; k++) {
            if (slopes[k].dx == slopes[k - 1].dx && slopes[k].dy == slopes[k - 1].dy) {
                localStreak++;
            } else {
                if (localStreak > currentMax) {
                    currentMax = localStreak;
                }
                localStreak = 1; // reset streak
            }
        }
        if (localStreak > currentMax) {
            currentMax = localStreak;
        }

        if (currentMax + 1 > globalMax) {
            globalMax = currentMax + 1;
        }
    }

    free(slopes);
    return globalMax;
}
